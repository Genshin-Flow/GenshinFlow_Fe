# 쿠키 및 session 데이터 지속시간

# 엑세스 쿠키 지속시간 (30분)
accessCookieTime=1800

# 리프레시 쿠키 지속시간 (7일)
refreshCookieTime=604800

# oauth 데이터 지속시간 (10분)
oauthSessionTime=600


# 포스트 가져오는 갯수

getHistorySize=10

